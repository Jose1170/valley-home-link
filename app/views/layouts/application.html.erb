<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Valley Home Link" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
      <div class="container">
        <%= link_to "ValleyHomeLink", job_requests_path, class: "navbar-brand fw-bold" %>
        
        <div class="navbar-nav me-auto">
          <%= link_to "Job Requests", job_requests_path, class: "nav-link" %>

          <% if current_user&.admin? %>
            <%= link_to "Users", users_path, class: "nav-link" %>
          <% end %>
        </div>

        <div class="navbar-nav">
          <% if current_user %>
            <span class="navbar-text me-3">
              Logged in: <strong><%= current_user.name %></strong> 
              <span class="badge bg-primary ms-1"><%= current_user.role.capitalize %></span>
            </span>
            <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline-danger btn-sm" %>
          <% else %>
            <%= link_to "Login", login_path, class: "nav-link" %>
            <%= link_to "Sign Up", signup_path, class: "btn btn-primary btn-sm ms-lg-2" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container bg-white shadow-sm p-5 rounded mb-5">
      
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>