<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-body">
          <h2 class="text-center mb-4">Join ValleyHomeLink</h2>
          <%= form_with(model: @user, url: signup_path) do |f| %>
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "Full Name" %>
            </div>
            <div class="mb-3">
              <%= f.label :username, class: "form-label" %>
              <%= f.text_field :username, class: "form-control" %>
            </div>
            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, class: "form-control" %>
            </div>
            <%= f.submit "Create Account", class: "btn btn-primary w-100" %>
          <% end %>
          <div class="mt-3 text-center">
            <%= link_to "Already have an account? Login", login_path %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>